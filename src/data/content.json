        {
          "id": "proj-bastion",
          "label": "Bastion",
          "kind": "project",
          "content": {
            "heading": "Bastion",
            "period": "Oct 2026",
            "description": "An autonomous blue-team agent that sits in front of a web app as a reverse proxy, watches its traffic and contains attacks on its own. A fast classifier flags suspicious requests, and an LLM investigator decides how to respond with no human in the loop.",
            "highlights": [
              "Two-tier triage: every request is scored by a classifier, and only flagged ones reach the LLM investigator.",
              "Diverts attackers to a honeypot, bans sources and installs route-scoped virtual patches, with every action recorded and executed at most once.",
              "Ships a full local lab: a de-fingerprinted vulnerable target and a red-team agent that attacks it."
            ],
            "stack": [
              "Python",
              "FastAPI",
              "Claude API",
              "SQLite",
              "Docker"
            ],
            "team": true,
            "links": [
              {
                "label": "GitHub",
                "url": "https://github.com/adamhjouj/bastion"
              }
            ]
          }
        },
        {
          "id": "proj-shieldclaw",
          "label": "ShieldClaw",
          "kind": "project",
          "content": {
            "heading": "ShieldClaw",
            "period": "2026",
            "description": "A security control plane for OpenClaw. Every AI agent gets its own machine identity, every request is checked against policy, risky actions go to a human for approval, and sensitive data is redacted before the agent sees it.",
            "highlights": [
              "FastAPI proxy in front of OpenClaw with a separate Auth0 identity for every agent.",
              "Scope checks and fine-grained authorization through OpenFGA policies.",
              "Risky actions are evaluated and can require human approval in Discord; sensitive data is redacted per agent."
            ],
            "stack": [
              "Python",
              "FastAPI",
              "Auth0",
              "OpenFGA",
              "TypeScript"
            ],
            "award": "Hack Canada 2026 winner",
            "team": true,
