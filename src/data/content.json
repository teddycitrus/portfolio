          "id": "proj-iris",
          "label": "Iris",
          "kind": "project",
          "content": {
            "heading": "Iris",
            "period": "Feb 2025",
            "description": "An accessibility tool that uses a webcam and speech to control a computer. People who cannot use a mouse or a keyboard can click, scroll, change tabs and type with it.",
            "highlights": [
              "It tracks the eyes and the mouth in real time and changes their movements into clicks, scroll actions and tab changes.",
              "Speech recognition operates offline and types the words that you speak. Movement and voice operate as one interface.",
              "I made it at Hack The Valley X (UTSC)."
            ],
            "stack": [
              "Python",
              "OpenCV",
              "MediaPipe",
              "Vosk",
              "PyAutoGUI"
            ],
            "videoId": "ZL2roGYZErk",
            "poster": "https://i.ytimg.com/vi/ZL2roGYZErk/maxres1.jpg",
            "award": "Hack The Valley X, Future Impact winner",
            "links": [
              {
                "label": "GitHub",
                "url": "https://github.com/teddycitrus/iris-application"
              }
            ]
          }
        },
        {
          "id": "proj-eureka",
          "label": "Eureka",
          "kind": "project",
          "content": {
            "heading": "Eureka",
            "period": "May 2026",
            "description": "It shows the risk to the suppliers and logistics of a company on an interactive globe. It compares news events with the supplier graph of the company. Then AI voice agents tell decision-makers about the risk and answer their questions in plain English.",
            "highlights": [
              "It gives each news event a score against the supplier graph of each company and identifies the suppliers that are at risk.",
              "Voice agents call people by phone, give them the risk report and answer their questions.",
              "We made it for EurekaHacks 2026 at the Accelerator Centre in Waterloo."
            ],
            "stack": [
              "Next.js",
              "TypeScript",
              "Three.js",
              "Gemini API",
              "Twilio",
              "ElevenLabs"
            ],
            "videoId": "A2EZWu-5rUs",
            "links": [
              {
                "label": "Live site",
                "url": "https://eureka-049.vercel.app"
              },
              {
                "label": "GitHub",
                "url": "https://github.com/teddycitrus/eureka"
              }
            ]
          }
        },
        {
          "id": "proj-bastion",
          "label": "Bastion",
          "kind": "project",
          "content": {
            "heading": "Bastion",
            "period": "Oct 2026",
            "description": "An autonomous blue-team agent that operates as a reverse proxy in front of a web app. It monitors the traffic and stops attacks without a human. A fast classifier finds suspicious requests, and an LLM investigator decides the response.",
            "highlights": [
              "Two-tier triage: a classifier gives a score to each request. Only the flagged requests go to the LLM investigator.",
              "It sends attackers to a honeypot, blocks their sources and installs virtual patches for specified routes. It records each action and does each action one time only.",
              "It includes a full local lab: a vulnerable target with its fingerprints removed, and a red-team agent that attacks the target."
            ],
            "stack": [
              "Python",
              "FastAPI",
              "Claude API",
              "SQLite",
              "Docker"
            ],
            "team": true,
            "links": [
              {
                "label": "GitHub",
                "url": "https://github.com/adamhjouj/bastion"
              }
            ]
          }
        },
        {
          "id": "proj-shieldclaw",
          "label": "ShieldClaw",
          "kind": "project",
          "content": {
            "heading": "ShieldClaw",
            "period": "2026",
            "description": "A security control plane for OpenClaw. Each AI agent gets its own machine identity, and the system checks each request against policy. Risky actions must get approval from a human. The system removes sensitive data before the agent sees it.",
            "highlights": [
              "A FastAPI proxy in front of OpenClaw gives each agent a separate Auth0 identity.",
              "OpenFGA policies do the scope checks and the fine-grained authorization.",
              "The system examines risky actions, and some actions must get human approval in Discord. It removes sensitive data for each agent."
            ],
            "stack": [
              "Python",
              "FastAPI",
              "Auth0",
              "OpenFGA",
              "TypeScript"
            ],
            "award": "Hack Canada 2026 winner",
            "team": true,
            "links": [
              {
                "label": "GitHub",
                "url": "https://github.com/adamhjouj/ShieldClaw"
              }
            ]
          }
        }
