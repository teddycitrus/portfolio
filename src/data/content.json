          "id": "proj-eureka",
          "label": "Eureka",
          "kind": "project",
          "content": {
            "heading": "Eureka",
            "period": "May 2026",
            "description": "Maps supplier and logistics exposure onto an interactive globe. It scores breaking news against a company's supplier graph and briefs decision-makers through AI voice agents they can question in plain English.",
            "highlights": [
              "News events are scored against each company's supplier graph to flag exposed suppliers.",
              "Voice agents brief people by phone and answer follow-up questions about their risk.",
              "Built for EurekaHacks 2026 at Waterloo's Accelerator Centre."
            ],
            "stack": [
              "Next.js",
              "TypeScript",
              "Three.js",
              "Gemini API",
              "Twilio",
              "ElevenLabs"
            ],
            "videoId": "A2EZWu-5rUs",
